{
  "name": "git-account-manager",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "author": {
    "name": "Khasky",
    "url": "https://github.com/khasky"
  },
  "description": "A desktop Git account manager for identity switching across popular code hosting platforms.",
  "keywords": [
    "git",
    "git-config",
    "account-manager",
    "identity",
    "ssh",
    "ssh-keys",
    "github",
    "gitlab",
    "bitbucket",
    "gpui",
    "desktop-app"
  ],
  "homepage": "https://github.com/khasky/git-account-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khasky/git-account-manager.git"
  },
  "bugs": {
    "url": "https://github.com/khasky/git-account-manager/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/khasky"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/khasky"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/khasky"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:desktop": "cargo run",
    "build:desktop": "cargo build --release --locked && cargo packager --release",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "screenshots": "cargo test --locked --lib ui::screenshots -- --ignored --test-threads=1",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commit-and-tag-version": "^12.7.3",
    "husky": "^9.1.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
